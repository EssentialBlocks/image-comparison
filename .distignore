# A set of files you probably don't want in your WordPress.org distribution

# Version control
.git
.gitattributes
.github
.gitignore
.gitlab-ci.yml
.gitmodules
.deployignore
.distignore

# CI
.circleci
.travis.yml
bitbucket-pipelines.yml
behat.yml
dependencies.yml
wp-cli.local.yml

# Editor / OS / tooling caches
.DS_Store
Thumbs.db
.editorconfig
.idea
.vscode
.claude
.eslintcache
*.log

# Build & lint configuration (source-only, never needed at runtime)
.babelrc
.babelrc.js
.babelrc.json
babel.config.js
.eslintignore
.eslintrc
.eslintrc.js
.eslintrc.json
.prettierrc
.prettierrc.js
.stylelintrc
.stylelintrc.json
webpack.config.js
Gruntfile.js
gulpfile.js
postcss.config.js
config

# Dependency manifests & installed dependencies
composer.json
composer.lock
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
node_modules
vendor

# Tests
tests
phpunit.xml
phpunit.xml.dist
multisite.xml
multisite.xml.dist
.phpcs.xml
.phpcs.xml.dist
phpcs.xml
phpcs.xml.dist
bin

# Sources — the built output in dist/ is what ships
src
util
controls
lib/style-handler/helpers.js
lib/style-handler/style-handler.js
lib/style-handler/gitignore
lib/style-handler/dist/index.js.map
lib/style-handler/README.md

# Internal docs & repo assets (readme.txt is the shipped one)
README.md
CHANGELOG.md
CONTRIBUTING.md
compatibility-report.md
.wordpress-org

# Source maps and archives
*.map
dist/*.*.map
*.sql
*.tar.gz
*.zip
**/*.zip
